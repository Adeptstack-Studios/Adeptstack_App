<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.ContentViews.NewsView"
             xmlns:utils="clr-namespace:Adeptstack_App.Utils"
             x:Name="this">

    <Border WidthRequest="340"
            BackgroundColor="#0f172a" 
            Stroke="#1e293b" 
            StrokeThickness="1" 
            StrokeShape="RoundRectangle 16"
            Margin="10, 10, 10, 24">

        <Grid BindingContext="{x:Reference this}">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0" 
                   Source="{Binding News.imageUrl, Converter={x:Static utils:DataSaverImageConverter.Instance}}" 
                   Aspect="AspectFill" />

            <BoxView Grid.Row="0" 
                     VerticalOptions="End" 
                     HeightRequest="1" 
                     Color="#1e293b" />

            <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" 
                           Text="{Binding News.category, FallbackValue='ADEPTSTACK'}" 
                           TextColor="#3b82f6" 
                           FontFamily="OpenSansSemibold" 
                           FontSize="12" 
                           TextTransform="Uppercase"
                           CharacterSpacing="1" />

                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="{Binding News.publishedAt, StringFormat='{0:MMM dd, yyyy}', FallbackValue='Apr 01, 2026'}"
                               TextColor="#94a3b8"
                               FontFamily="OpenSansRegular"
                               FontSize="12" />

                        <Label Text="·"
                               IsVisible="{Binding News.HasReadingTime}"
                               TextColor="#475569"
                               FontSize="12" />

                        <Label Text="{Binding News.ReadingTimeText}"
                               IsVisible="{Binding News.HasReadingTime}"
                               TextColor="#94a3b8"
                               FontFamily="OpenSansRegular"
                               FontSize="12" />
                    </HorizontalStackLayout>
                </Grid>

                <Label Text="{Binding News.title, FallbackValue='Update Title'}" 
                       TextColor="#f8fafc"
                       FontFamily="OpenSansSemibold" 
                       FontSize="18" 
                       LineBreakMode="TailTruncation"
                       MaxLines="2" />

                <Label Text="{Binding News.description, FallbackValue='Hier steht eine kurze Zusammenfassung des Updates, damit man direkt weiß, worum es im Artikel geht.'}" 
                       TextColor="#94a3b8" 
                       FontFamily="OpenSansRegular" 
                       FontSize="14" 
                       LineBreakMode="TailTruncation"
                       MaxLines="3" />

            </VerticalStackLayout>

            <Button Grid.RowSpan="2" 
                    BackgroundColor="Transparent" 
                    x:Name="clickedOn" 
                    Clicked="clickedOn_Clicked" />
        </Grid>
    </Border>
</ContentView>