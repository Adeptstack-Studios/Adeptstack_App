<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.ContentViews.AppView" 
             x:Name="this">

    <!-- WICHTIG: BindingContext ist jetzt hier oben! Dadurch funktioniert die Opacity. -->
    <Border BindingContext="{x:Reference this}" 
            WidthRequest="340" 
            HeightRequest="80" 
            BackgroundColor="{DynamicResource Surface}" 
            Margin="10,10,10,16" 
            StrokeShape="RoundRectangle 16" 
            StrokeThickness="1" 
            Stroke="{DynamicResource Border}">

        <!-- Der Trigger dimmt jetzt die gesamte Karte auf 40% runter -->
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding App.legacy}" Value="True">
                <Setter Property="Opacity" Value="0.65" />
            </DataTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Grid Grid.Column="0" Padding="15">
                <Image x:Name="iconImage" Source="{Binding App.iconUrl}" Aspect="AspectFill" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" />
            </Grid>

            <!-- Text -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Grid Margin="0,0,0,0">
                    <Label Text="{Binding App.name, FallbackValue='Title'}" TextColor="{DynamicResource TextPrimary}" VerticalTextAlignment="Center" FontFamily="OpenSansSemibold" FontSize="18" />
                </Grid>

                <FlexLayout JustifyContent="SpaceBetween" AlignItems="Center" Wrap="NoWrap">
                    <Label Text="{Binding App.slogan, FallbackValue='slogan'}" TextColor="{DynamicResource TextSecondary}" VerticalTextAlignment="Center" FontFamily="OpenSansRegular" FontSize="13" />
                </FlexLayout>
            </VerticalStackLayout>

            <!-- DEIN BADGE: Originale Form, nicht mehr gepresst, nur farblich modernisiert -->
            <Grid Grid.Column="1" VerticalOptions="Start" HorizontalOptions="End" Margin="15,10" IsVisible="{Binding App.legacy, FallbackValue=False}">
                <Border StrokeShape="RoundRectangle 5" Padding="5,2" BackgroundColor="{DynamicResource SurfaceAlt}" Stroke="{DynamicResource BorderStrong}" StrokeThickness="1">
                    <Label Text="Legacy" TextColor="{DynamicResource TextBody}" FontSize="12" FontAttributes="Bold" />
                </Border>
            </Grid>

            <!-- Grid.ColumnSpan="2" sorgt dafür, dass der Klick auf der ganzen Karte registriert wird -->
            <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" x:Name="clickedOn" Clicked="clickedOn_Clicked" />
        </Grid>
    </Border>
</ContentView>