<?xml version="1.0" encoding="utf-8" ?>
<pages:BottomSheet xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:pages="clr-namespace:Adeptstack_App.Pages"
                   x:Class="Adeptstack_App.Pages.CardActionSheet">

    <!-- Hintergrund, Griff, Animation und Wischen kommen aus BottomSheet -->
    <pages:BottomSheet.SheetContent>
        <VerticalStackLayout>
            <!-- Vorschau der Karte -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="0,0,0,14">
                <Border x:Name="previewImageFrame"
                        WidthRequest="64"
                        HeightRequest="44"
                        BackgroundColor="#1e293b"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Image x:Name="previewImage" Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label x:Name="captionLabel"
                           TextColor="#3b82f6"
                           FontFamily="OpenSansSemibold"
                           FontSize="11"
                           TextTransform="Uppercase"
                           CharacterSpacing="1" />

                    <Label x:Name="titleLabel"
                           TextColor="#f8fafc"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="#1e293b" />

            <!-- Transparenter Hintergrund, damit die ganze Zeile den Tap bekommt -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Padding="4,14,4,10" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Share_Tapped" />
                </Grid.GestureRecognizers>

                <Image Source="share.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <Label x:Name="shareLabel"
                       Grid.Column="1"
                       TextColor="#f8fafc"
                       FontFamily="OpenSansRegular"
                       FontSize="15"
                       VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Padding="4,10,4,4" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Bookmark_Tapped" />
                </Grid.GestureRecognizers>

                <Image x:Name="bookmarkIcon" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <Label x:Name="bookmarkLabel"
                       Grid.Column="1"
                       TextColor="#f8fafc"
                       FontFamily="OpenSansRegular"
                       FontSize="15"
                       VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </pages:BottomSheet.SheetContent>
</pages:BottomSheet>
