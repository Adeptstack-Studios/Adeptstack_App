<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Adeptstack_App.Pages.CardActionSheet"
             ios:Page.ModalPresentationStyle="OverFullScreen"
             BackgroundColor="Transparent">

    <!-- Transparentes Modal: die Seite dahinter bleibt sichtbar und wird über backdrop abgedunkelt. -->
    <Grid>
        <BoxView x:Name="backdrop" Color="#99020617" Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Backdrop_Tapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Die Ziehgeste liegt auf diesem feststehenden Container und nicht auf dem Sheet selbst:
             bewegt sich das Element unter dem Finger mit, springen die gemessenen Werte auf Android hin und her. -->
        <Grid VerticalOptions="End" MaximumWidthRequest="600" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="Sheet_PanUpdated" />
            </Grid.GestureRecognizers>

            <!-- TranslationY startet unterhalb des Bildschirms, OnAppearing fährt das Sheet hoch -->
            <Border x:Name="sheet"
                    TranslationY="600"
                    BackgroundColor="#0f172a"
                    Stroke="#1e293b"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    Padding="16,10,16,28">

                <VerticalStackLayout>
                    <!-- Griff -->
                    <BoxView WidthRequest="36"
                             HeightRequest="4"
                             CornerRadius="2"
                             Color="#334155"
                             HorizontalOptions="Center"
                             Margin="0,0,0,14" />

                    <!-- Vorschau der Karte -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Padding="0,0,0,14">
                        <Border x:Name="previewImageFrame"
                                WidthRequest="64"
                                HeightRequest="44"
                                BackgroundColor="#1e293b"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <Image x:Name="previewImage" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="captionLabel"
                                   TextColor="#3b82f6"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="11"
                                   TextTransform="Uppercase"
                                   CharacterSpacing="1" />

                            <Label x:Name="titleLabel"
                                   TextColor="#f8fafc"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1e293b" />

                    <!-- Transparenter Hintergrund, damit die ganze Zeile den Tap bekommt -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Padding="4,14,4,10" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Share_Tapped" />
                        </Grid.GestureRecognizers>

                        <Image Source="share.png" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label x:Name="shareLabel"
                               Grid.Column="1"
                               TextColor="#f8fafc"
                               FontFamily="OpenSansRegular"
                               FontSize="15"
                               VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" Padding="4,10,4,4" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="Bookmark_Tapped" />
                        </Grid.GestureRecognizers>

                        <Image x:Name="bookmarkIcon" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                        <Label x:Name="bookmarkLabel"
                               Grid.Column="1"
                               TextColor="#f8fafc"
                               FontFamily="OpenSansRegular"
                               FontSize="15"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
