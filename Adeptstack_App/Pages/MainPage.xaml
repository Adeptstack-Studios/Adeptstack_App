<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.MainPage"
             BackgroundColor="{DynamicResource PageBackground}">

    <!-- Shell.TitleView -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="10,0,16,0">
            <Label x:Name="headerTitle" 
                   Text="Adeptstack News" 
                   TextColor="{DynamicResource TextPrimary}" 
                   VerticalOptions="Center" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   FontFamily="Roboto"/>

            <SearchBar x:Name="searchBar" 
                       IsVisible="False" 
                       Placeholder="Search updates..." 
                       TextColor="{DynamicResource TextPrimary}" 
                       PlaceholderColor="{DynamicResource TextSecondary}" 
                       CancelButtonColor="{DynamicResource TextPrimary}" 
                       BackgroundColor="Transparent"
                       TextChanged="SearchBar_TextChanged" 
                       VerticalOptions="Center" />

            <Image x:Name="searchIconBtn"
               Grid.Column="1"
               Source="{AppThemeBinding Light=search_dark.png, Dark=search.png}" 
               Aspect="AspectFit"
               WidthRequest="28" 
               HeightRequest="28" 
               VerticalOptions="Center" 
               BackgroundColor="Transparent"
               Margin="0,0,0,0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SearchIcon_Clicked" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <!-- Layer 1: Der Content -->
        <RefreshView x:Name="refresh" Refreshing="RefreshView_Refreshing" RefreshColor="{DynamicResource Accent}">
            <ScrollView x:Name="scroll" Scrolled="Scroll_Scrolled">
                <VerticalStackLayout Padding="16,24,16,24" SizeChanged="Content_SizeChanged">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,16">
                        <HorizontalStackLayout x:Name="categoryLayout" Spacing="12" HorizontalOptions="Center" />
                    </ScrollView>

                    <!-- Trefferanzahl und Sortierung -->
                    <Grid ColumnDefinitions="*, Auto"
                          MaximumWidthRequest="1130"
                          Margin="10,0,10,8">
                        <Label x:Name="resultCountLabel"
                               TextColor="{DynamicResource TextSecondary}"
                               FontFamily="OpenSansRegular"
                               FontSize="13"
                               VerticalOptions="Center" />

                        <Button x:Name="sortButton"
                                Grid.Column="1"
                                Text="NEWEST ▾"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="16,0"
                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                TextColor="{DynamicResource TextPrimary}"
                                Clicked="Sort_Clicked" />
                    </Grid>

                    <FlexLayout x:Name="newsLayout"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Start"
                                MaximumWidthRequest="1150"/>

                    <!-- Kein Treffer für Suche/Filter. Bewusst kein Overlay, damit die Chips bedienbar bleiben. -->
                    <Label x:Name="noResultsLabel"
                           Text="No results found"
                           IsVisible="False"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           Margin="0,48,0,0" />

                    <!-- Nachladen der nächsten Seite beim Scrollen -->
                    <ActivityIndicator x:Name="pageLoading"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{DynamicResource Accent}"
                                       HorizontalOptions="Center"
                                       Margin="0,8,0,8" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Layer 2: Empty / Error State -->
        <Grid x:Name="nothing" IsVisible="False" BackgroundColor="{DynamicResource PageBackground}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label x:Name="emptyStateLabel"
                       Text="No Updates Available" 
                       TextColor="{DynamicResource TextPrimary}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center" />

                <Label x:Name="internet" 
                       Text="Please check your internet connection." 
                       TextColor="{DynamicResource TextSecondary}" 
                       FontSize="14" 
                       IsVisible="False" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Layer 3: Loading State -->
        <Grid x:Name="loading" BackgroundColor="{DynamicResource Overlay}" IsVisible="False">
            <ActivityIndicator x:Name="busy" 
                               IsRunning="True" 
                               Color="{DynamicResource Accent}" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>