<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.DisplayContent"
             Title="DisplayContent">
    <Grid BackgroundColor="Black">
        <ScrollView VerticalScrollBarVisibility="Never" >
            <WebView x:Name="web" Navigating="web_Navigating" >

            </WebView>
        </ScrollView>
        <Grid BackgroundColor="Black" x:Name="nothing" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" >
                <Label Text="No Content available" TextColor="White" HorizontalOptions="Center" FontSize="Medium" FontAttributes="Bold" />
                <Label x:Name="internet" Text="Check Internet connection" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" Opacity="0.7" FontSize="Subtitle" IsVisible="False" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>