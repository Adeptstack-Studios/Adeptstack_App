<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.AppChangelog"
             Title="AppChangelog">
    <Grid BackgroundColor="Black">
        <RefreshView x:Name="refresh" Refreshing="RefreshView_Refreshing" >
            <ScrollView>
                <VerticalStackLayout>
                    <Grid x:Name="legacy">
                        <Border BackgroundColor="#1E1A18" Stroke="#5C4424" StrokeThickness="1" Padding="16" Margin="30,20" MaximumWidthRequest="800">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="&#x26A0;" TextColor="#F59E0B" FontSize="28" VerticalOptions="Center" VerticalTextAlignment="Center"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Legacy Software" TextColor="#F59E0B" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="This application is no longer actively developed and only receives security-related or limited updates." TextColor="#D97706" FontSize="14" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid>
                        <FlexLayout x:Name="changelogsLayout" Wrap="Wrap" HorizontalOptions="Center">

                        </FlexLayout>
                        <Grid BackgroundColor="Black" x:Name="nothing" IsVisible="False">
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" >
                                <Label Text="No Content available" TextColor="White" HorizontalOptions="Center" FontSize="Medium" FontAttributes="Bold" />
                                <Label x:Name="internet" Text="Check Internet connection" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" Opacity="0.7" FontSize="Subtitle" IsVisible="False" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid BackgroundColor="Black" x:Name="loading" IsVisible="False">
                            <ActivityIndicator x:Name="busy" IsRunning="True" VerticalOptions="Start" HorizontalOptions="Center" Color="White" Margin="0,70,0,0" />
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>