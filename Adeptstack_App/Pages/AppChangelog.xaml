<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.AppChangelog"
             BackgroundColor="{DynamicResource PageBackground}">

    <Grid>
        <!-- Layer 1: Content -->
        <RefreshView x:Name="refresh" Refreshing="RefreshView_Refreshing" RefreshColor="{DynamicResource Accent}">
            <ScrollView x:Name="scroll" Scrolled="Scroll_Scrolled">
                <VerticalStackLayout Padding="16,24,16,24" Spacing="16" SizeChanged="Content_SizeChanged">

                    <!-- Legacy Warning Banner -->
                    <Border x:Name="legacy"
                            IsVisible="False"
                            BackgroundColor="{DynamicResource WarningBackground}"
                            Stroke="{DynamicResource WarningBorder}"
                            StrokeThickness="1"
                            Padding="16"
                            MaximumWidthRequest="800"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#x26A0;" TextColor="{DynamicResource Warning}" FontSize="28" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="Legacy Software" TextColor="{DynamicResource Warning}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="This application is no longer actively developed and only receives security-related or limited updates."
                                       TextColor="{DynamicResource WarningText}"
                                       FontSize="14"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- App-Auswahl, nur bei "All Updates" -->
                    <ScrollView x:Name="appChips" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="False">
                        <HorizontalStackLayout x:Name="appLayout" Spacing="12" HorizontalOptions="Center" />
                    </ScrollView>

                    <!-- Channels, nur wenn es mehr als einen gibt -->
                    <ScrollView x:Name="channelChips" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="False">
                        <HorizontalStackLayout x:Name="channelLayout" Spacing="12" HorizontalOptions="Center" />
                    </ScrollView>

                    <!-- Trefferanzahl und Sortierung -->
                    <Grid ColumnDefinitions="*, Auto"
                          MaximumWidthRequest="1120"
                          Margin="8,0,8,0">
                        <Label x:Name="resultCountLabel"
                               TextColor="{DynamicResource TextSecondary}"
                               FontFamily="OpenSansRegular"
                               FontSize="13"
                               VerticalOptions="Center" />

                        <Button x:Name="sortButton"
                                Grid.Column="1"
                                Text="NEWEST ▾"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                CornerRadius="18"
                                HeightRequest="36"
                                Padding="16,0"
                                BackgroundColor="{DynamicResource SurfaceAlt}"
                                TextColor="{DynamicResource TextPrimary}"
                                Clicked="Sort_Clicked" />
                    </Grid>

                    <!-- MaximumWidthRequest 1150 erlaubt genau 3 Karten (á ~340px) nebeneinander -->
                    <FlexLayout x:Name="changelogsLayout"
                                MaximumWidthRequest="1150"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Start"
                                AlignContent="Start"
                                HorizontalOptions="Center" />

                    <!-- Kein Treffer für den gewählten Channel. Bewusst kein Overlay, damit die Chips bedienbar bleiben. -->
                    <Label x:Name="noResultsLabel"
                           Text="No updates found"
                           IsVisible="False"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           Margin="0,32,0,0" />

                    <!-- Nachladen der nächsten Seite beim Scrollen -->
                    <ActivityIndicator x:Name="pageLoading"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{DynamicResource Accent}"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Layer 2: Empty / Error State -->
        <Grid x:Name="nothing" IsVisible="False" BackgroundColor="{DynamicResource PageBackground}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="No Updates Available"
                       TextColor="{DynamicResource TextPrimary}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="internet"
                       Text="Please check your internet connection."
                       TextColor="{DynamicResource TextSecondary}"
                       FontSize="14"
                       IsVisible="False"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Layer 3: Loading State (Halbtransparent) -->
        <Grid x:Name="loading" BackgroundColor="{DynamicResource Overlay}" IsVisible="False">
            <ActivityIndicator x:Name="busy"
                               IsRunning="True"
                               Color="{DynamicResource Accent}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
