<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Adeptstack_App.AppChangelog"
             BackgroundColor="#020617">

    <Grid>
        <!-- Layer 1: Content -->
        <RefreshView x:Name="refresh" Refreshing="RefreshView_Refreshing" RefreshColor="#3b82f6">
            <ScrollView>
                <VerticalStackLayout Padding="16,24,16,24" Spacing="24">

                    <!-- Legacy Warning Banner -->
                    <Border x:Name="legacy" 
                            BackgroundColor="#1E1A18" 
                            Stroke="#5C4424" 
                            StrokeThickness="1" 
                            Padding="16" 
                            MaximumWidthRequest="800"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="&#x26A0;" TextColor="#F59E0B" FontSize="28" VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="Legacy Software" TextColor="#F59E0B" FontAttributes="Bold" FontSize="16" />
                                <Label Text="This application is no longer actively developed and only receives security-related or limited updates." 
                                       TextColor="#D97706" 
                                       FontSize="14" 
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Changelogs FlexLayout -->
                    <!-- MaximumWidthRequest 1150 erlaubt genau 3 Karten (á ~340px) nebeneinander -->
                    <FlexLayout x:Name="changelogsLayout" 
                                MaximumWidthRequest="1150" 
                                Wrap="Wrap" 
                                JustifyContent="Center" 
                                AlignItems="Start"
                                AlignContent="Start"
                                HorizontalOptions="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Layer 2: Empty / Error State -->
        <Grid x:Name="nothing" IsVisible="False" BackgroundColor="#020617">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="No Updates Available" 
                       TextColor="#f8fafc" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center" />

                <Label x:Name="internet" 
                       Text="Please check your internet connection." 
                       TextColor="#94a3b8" 
                       FontSize="14" 
                       IsVisible="False" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Layer 3: Loading State (Halbtransparent) -->
        <Grid x:Name="loading" BackgroundColor="#CC020617" IsVisible="False">
            <ActivityIndicator x:Name="busy" 
                               IsRunning="True" 
                               Color="#3b82f6" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>